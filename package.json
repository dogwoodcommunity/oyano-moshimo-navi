{
  "name": "oyano-moshimo-navi-v0-3",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter web run dev",
    "dev:web:lan": "pnpm --dir apps/web exec next dev -H 0.0.0.0 -p 3000",
    "dev:mobile": "pnpm --filter mobile run start",
    "doctor:local": "node scripts/local-doctor.mjs",
    "doctor:mobile-build": "node scripts/mobile-build-doctor.mjs",
    "eas:whoami": "pnpm dlx eas-cli whoami",
    "eas:login": "pnpm dlx eas-cli login",
    "eas:mobile:init": "cd apps/mobile && pnpm dlx eas-cli init",
    "eas:mobile:set-project-id": "node scripts/set-mobile-eas-project-id.mjs",
    "eas:mobile:build:ios": "cd apps/mobile && pnpm dlx eas-cli build --profile preview --platform ios",
    "eas:mobile:build:android": "cd apps/mobile && pnpm dlx eas-cli build --profile preview --platform android",
    "lint": "pnpm --filter web run lint",
    "test:stage-a-local": "node scripts/test-stage-a-local.mjs",
    "test:stage-a-local-runner": "node scripts/test-stage-a-local-runner.mjs",
    "review:zip": "node scripts/create-review-zip.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "smoke:monitor": "node scripts/smoke-monitor-journey.mjs",
    "test:monitor-timeline": "node scripts/test-monitor-timeline.mjs",
    "test:monitor-retention": "node scripts/test-monitor-retention.mjs",
    "test:monitor-submission-gate": "node scripts/test-monitor-submission-gate.mjs",
    "test:cron-auth": "node scripts/test-cron-auth.mjs",
    "test:monthly-checkin:sql": "bash scripts/test-monthly-checkin-sql.sh",
    "test:notebook-sync-safety": "node scripts/test-notebook-sync-safety.mjs",
    "test:notebook-sync-runtime": "node scripts/test-notebook-sync-runtime.mjs",
    "test:diary-deletion": "node scripts/test-diary-deletion.mjs",
    "test:diary-deletion:sql": "bash scripts/test-notebook-diary-delete-sql.sh",
    "test:person-deletion": "node scripts/test-notebook-person-deletion.mjs",
    "test:person-deletion:sql": "bash scripts/test-notebook-person-delete-sql.sh",
    "test:memory-book-export": "node scripts/test-memory-book-export.mjs",
    "test:free-first-redesign": "node scripts/test-free-first-redesign.mjs",
    "test:web-account-deletion": "node scripts/test-web-account-deletion.mjs",
    "test:account-delete-executor": "node scripts/test-account-delete-executor-auth.mjs",
    "test:admin-delete-access-check": "node scripts/test-admin-delete-access-check.mjs",
    "test:delete-operator-mfa-setup": "node scripts/test-delete-operator-mfa-setup.mjs",
    "test:account-erasure:sql": "bash scripts/test-account-erasure-sql.sh",
    "test:home-overview-reachability": "node scripts/test-home-overview-reachability.mjs",
    "test:commercial-release-gates": "node scripts/test-commercial-release-gates.mjs",
    "test:public-operator-disclosure": "node scripts/test-public-operator-disclosure.mjs",
    "test:family-role-security": "node scripts/test-family-role-security.mjs",
    "test:family-invite-permissions": "node scripts/test-family-invite-permissions.mjs",
    "test:family-role-security:sql": "bash scripts/test-family-role-rls-sql.sh",
    "test:family-context-selection": "node scripts/test-family-context-selection.mjs",
    "test:family-management": "node scripts/test-family-management.mjs",
    "test:family-management:sql": "bash scripts/test-family-management-sql.sh",
    "test:handoff-security": "node scripts/test-handoff-security.mjs",
    "test:handoff-security:sql": "bash scripts/test-handoff-ownership-sql.sh",
    "smoke:notebook-sync": "node scripts/smoke-notebook-sync.mjs",
    "smoke:production-consent": "node scripts/smoke-production-consent.mjs",
    "test:consult-memory": "node scripts/test-consult-memory.mjs && node scripts/test-consult-route.mjs",
    "test:consult-memory:sql": "bash scripts/test-ai-consult-memory-sql.sh",
    "test:consult-daily-claim:sql": "bash scripts/test-consult-daily-claim-sql.sh",
    "typecheck": "pnpm --filter web run typecheck && pnpm --filter mobile run typecheck"
  },
  "devDependencies": {
    "next": "^14.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
