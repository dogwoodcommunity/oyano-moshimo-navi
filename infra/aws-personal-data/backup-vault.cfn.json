       },
       "Condition": {
        "StringLike": {
         "s3:prefix": [
          "backups/*"
         ]
        }
       }
      },
      {
       "Sid": "ListReceiptPrefixOnly",
       "Effect": "Allow",
       "Action": "s3:ListBucket",
       "Resource": {
