NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ACCESS_TOKEN=
# Auth・DB・Storageを不可逆に削除する管理者処理。DB移行と手順確認後だけtrueにする
ACCOUNT_ERASURE_EXECUTION_ENABLED=false
# 7日間モニター採用者のクラウドワークス表示名。カンマ区切り。未設定なら回答受付を開かない
MONITOR_ALLOWED_CROWDWORKS_NAMES=
STRIPE_SECRET_KEY=
# 有料受付は必要設定に加えて、この安全スイッチを true にした場合だけ開く
COMMERCIAL_SUPPORT_PACK_SALES_ENABLED=false
COMMERCIAL_PLUS_SALES_ENABLED=false
STRIPE_SUPPORT_PACK_PRICE_ID=
# Plusの継続課金。未設定の間は受付を開かない
STRIPE_PLUS_PRICE_ID=
# 例: 月額980円。未設定なら /plans は「準備中」と出す
NEXT_PUBLIC_PLUS_PRICE_LABEL=
# 運営主体・責任者・問い合わせ・施行日は無料正式版でも必須。ほかは有料受付前に確定する
LEGAL_BUSINESS_NAME=
LEGAL_RESPONSIBLE_PERSON=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_PHONE_HOURS=
LEGAL_CONTACT=
LEGAL_TERMS_EFFECTIVE_DATE=
LEGAL_PRIVACY_EFFECTIVE_DATE=
LEGAL_PRICE_DESCRIPTION=
LEGAL_SERVICE_DELIVERY=
LEGAL_CANCELLATION_POLICY=
# App内課金を入れる場合。docs/IN_APP_PURCHASE_PLAN.md を参照
REVENUECAT_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=
# 期限・月1確認メールを送る場合。どちらか片方でも未設定ならメールだけを安全に停止する
RESEND_API_KEY=
# 例: 親のもしもナビ <notification@example.com>（Resendで認証済みの送信元）
NOTIFICATION_EMAIL_FROM=
# 任意。返信を受ける窓口がある場合だけ設定する
NOTIFICATION_EMAIL_REPLY_TO=
# 長期相談 (/consult) を有効にする場合のみ設定する
ANTHROPIC_API_KEY=
# 相談の上限。未設定なら 利用者ごと5回/日、Plus家族30回/月、サービス全体50回/日
CONSULT_CLIENT_DAILY_LIMIT=
CONSULT_FAMILY_MONTHLY_LIMIT=
CONSULT_DAILY_LIMIT=
# 1回答の出力上限。未設定なら1600。安全のためコード側でも800〜2000に制限する
CONSULT_MAX_OUTPUT_TOKENS=
# 1 にすると出力が最大2.5倍速になる代わりに料金が2倍になる
CONSULT_FAST_MODE=
ANONYMOUS_CASE_RETENTION_DAYS=30
ANONYMOUS_CASE_PURGE_LIMIT=100
NEXT_PUBLIC_APP_SCHEME=oyanomoshimo
# ストア公開後に設定する。未設定の間はWeb側にアプリ導線を出さない
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
