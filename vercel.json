{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter web run build",
  "devCommand": "pnpm --filter web run dev",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/send-due-notifications",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/purge-anonymous-cases",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/cleanup-notebook-storage",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cleanup-person-notebook-storage",
      "schedule": "15 4 * * *"
    }
  ]
}
